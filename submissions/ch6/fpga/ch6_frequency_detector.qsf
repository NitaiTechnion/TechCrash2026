# Project: Challenge 6 - Frequency Detector
# Quartus Settings File (QSF)

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "2026-06-04 10:00:00"
set_global_assignment -name LAST_QUARTUS_VERSION 17.1.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SYSTEMVERILOG_FILE src/ch6_frequency_detector.sv
set_global_assignment -name TOP_LEVEL_ENTITY ch6_frequency_detector
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2012

# Clock assignment
set_location_assignment PIN_P11 -to MAX10_CLK1_50

# Switch assignments
set_location_assignment PIN_B8 -to SW[0]
